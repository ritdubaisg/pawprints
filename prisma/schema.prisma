// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id // Firebase UID
  email        String  @unique
  name         String?
  displayName  String?
  hasAccess    Int     @default(1)
  isStaff      Boolean @default(false)
  isSuperAdmin Boolean @default(false)
  permissions  Int     @default(0)

  // How the account signs in. Google accounts (@g.rit.edu) self-provision on
  // first login; "password" accounts are issued by a superadmin for faculty
  // and staff, who have no Google identity.
  authProvider       String    @default("google") // "google" | "password"
  // Set when a superadmin issues or regenerates a password. The holder is
  // forced through /onboarding until they choose their own.
  mustChangePassword Boolean   @default(false)
  passwordUpdatedAt  DateTime?
  // Suspends sign-in without deleting the account (petitions reference users).
  disabled           Boolean   @default(false)
  issuedById         String?

  createdPetitions Petition[] @relation("CreatedPetitions")
  signedPetitions  Petition[] @relation("SignedPetitions")
  subscriptions    Petition[] @relation("SubscribedPetitions")

  notificationSettings NotificationSettings?

  reports       Report[]
  notifications Notification[]
  auditLogs     AuditLog[]

  petitionReviews    PetitionReview[]
  reviewAssignments  PetitionAssignment[]  @relation("ReviewAssignee")
  assignmentsMade    PetitionAssignment[]  @relation("AssignedBy")
  reviewPools        ReviewStageMember[]   @relation("PoolMember")
  poolMembersAdded   ReviewStageMember[]   @relation("PoolAddedBy")
  reviewEventsCaused PetitionReviewEvent[] @relation("ReviewEventActor")
  reviewEventsAbout  PetitionReviewEvent[] @relation("ReviewEventSubject")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model NotificationSettings {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  update    Boolean @default(true)
  response  Boolean @default(true)
  reported  Boolean @default(false)
  threshold Boolean @default(true)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  type      String // UPDATE, RESPONSE, THRESHOLD, REPORT, SYSTEM

  petitionId Int?
  petition   Petition? @relation(fields: [petitionId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}

model GlobalAlert {
  id      Int     @id @default(autoincrement())
  active  Boolean @default(true)
  content String
}

model Petition {
  id                  Int       @id @default(autoincrement())
  title               String    @db.VarChar(150)
  description         String
  authorId            String
  author              User      @relation("CreatedPetitions", fields: [authorId], references: [id])
  signers             User[]    @relation("SignedPetitions")
  subscribers         User[]    @relation("SubscribedPetitions")
  signatures          Int       @default(0)
  targetSignatures    Int       @default(200)
  tier                Int       @default(3)
  createdAt           DateTime  @default(now())
  status              Int       @default(0) // 0: New, 1: Published, 2: Removed, 3: NeedsReview
  expires             DateTime
  lastSigned          DateTime?
  hasResponse         Boolean   @default(false)
  thresholdNotifiedAt DateTime?
  responseId          Int?
  response            Response? @relation(fields: [responseId], references: [id])

  inProgress Boolean? @default(false)
  updates    Update[]
  tags       Tag[]
  oldId      String?

  // Index into REVIEW_STAGES (lib/review-stages.ts). Every stage below this
  // one has already been satisfied; equal to the stage count means review is
  // complete. Resubmission after a return resets it to 0.
  reviewStage  Int                   @default(0)
  reviews      PetitionReview[]
  assignments  PetitionAssignment[]
  reviewEvents PetitionReviewEvent[]

  reports Report[]

  notifications Notification[]

  @@index([status])
  @@index([authorId])
  @@index([createdAt])
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(50)
  petitions Petition[]
}

model Response {
  id          Int        @id @default(autoincrement())
  description String
  createdAt   DateTime   @default(now())
  author      String
  petitions   Petition[]
}

model Update {
  id          Int        @id @default(autoincrement())
  description String
  createdAt   DateTime   @default(now())
  author      String?
  petitions   Petition[]
}

model Report {
  id          Int      @id @default(autoincrement())
  petitionId  Int
  petition    Petition @relation(fields: [petitionId], references: [id])
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  reportedAt  DateTime
  reportedFor String   @default("")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

/**
 * One reviewer's decision on one stage of one petition.
 * Unique per (petition, stage, reviewer): submitting again replaces the
 * earlier decision rather than stacking, so a reviewer who requested changes
 * can approve later without their block lingering.
 */
model PetitionReview {
  id         Int      @id @default(autoincrement())
  petitionId Int
  petition   Petition @relation(fields: [petitionId], references: [id])
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  stage      Int
  decision   String // APPROVE | CHANGES_REQUESTED
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([petitionId, stage, reviewerId])
  @@index([petitionId])
}

/**
 * A named reviewer a petition is waiting on. Assignment is additive to the
 * quorum: a stage needs its minimum approvals AND an approval from every
 * person assigned to it.
 */
model PetitionAssignment {
  id           Int      @id @default(autoincrement())
  petitionId   Int
  petition     Petition @relation(fields: [petitionId], references: [id])
  assigneeId   String
  assignee     User     @relation("ReviewAssignee", fields: [assigneeId], references: [id])
  stage        Int
  assignedById String?
  assignedBy   User?    @relation("AssignedBy", fields: [assignedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([petitionId, stage, assigneeId])
  @@index([petitionId])
}

/**
 * Who is allowed to review at a given stage.
 * Membership is the authority: being in the "sg" pool is what makes someone a
 * Student Government reviewer, not a permission bit or a job title. Only
 * superadmins edit these lists, and `stageKey` matches a key in REVIEW_STAGES
 * so a stage added to that array simply starts with an empty pool.
 */
model ReviewStageMember {
  id        Int      @id @default(autoincrement())
  stageKey  String
  userId    String
  user      User     @relation("PoolMember", fields: [userId], references: [id])
  addedById String?
  addedBy   User?    @relation("PoolAddedBy", fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@unique([stageKey, userId])
  @@index([stageKey])
}

/**
 * Assignment history, as opposed to current state.
 * `PetitionAssignment` only says who is assigned now, so removing someone
 * erased the fact that they ever were. The timeline needs the record, not the
 * state — these rows are append-only and never deleted.
 */
model PetitionReviewEvent {
  id         Int      @id @default(autoincrement())
  petitionId Int
  petition   Petition @relation(fields: [petitionId], references: [id])
  type       String // ASSIGNED | UNASSIGNED
  stage      Int
  actorId    String?
  actor      User?    @relation("ReviewEventActor", fields: [actorId], references: [id])
  subjectId  String
  subject    User     @relation("ReviewEventSubject", fields: [subjectId], references: [id])
  createdAt  DateTime @default(now())

  @@index([petitionId])
}

model LinkSafetyCache {
  url        String   @id
  isSafe     Boolean
  checkedAt  DateTime @default(now())
  threatType String?
}
